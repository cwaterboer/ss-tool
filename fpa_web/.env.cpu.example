# CPU Processing Configuration Example
# Copy this to .env.cpu for CPU-only development setup

# LingBot Checkpoint
# Downloaded from: https://huggingface.co/robbyant/lingbot-map
# Default: /tmp/checkpoints/lingbot-map.pt
LINGBOT_CHECKPOINT_PATH=/tmp/checkpoints/lingbot-map.pt

# Torch Multithreading (CPU optimization)
# Set to CPU core count - 2 for best performance
# Leave blank to auto-detect
OMP_NUM_THREADS=8
OPENBLAS_NUM_THREADS=8
MKL_NUM_THREADS=8

# Task Timeout (seconds)
# CPU inference needs more time: 2 hours = 7200s
# For GPU: 600-1800s is typical
CELERY_TASK_TIME_LIMIT=7200

# Memory Settings
# Recommended minimum: 16GB available RAM
# For scans > 100 frames: 24GB+
SCAN_FRAME_LIMIT=50

# Batch Processing
# CPU processes frames sequentially for stability
# Keep keyframe_interval high to reduce total inference frames
DEFAULT_KEYFRAME_INTERVAL=1

# Device Preferences
# System automatically selects CPU if no CUDA device found
# To force CPU:
TORCH_DEVICE=cpu

# Logging
# Verbose CPU processing logs
LOGGING_LEVEL=INFO
LOG_INFERENCE_TIMING=true
